{
  "$schema": "https://biomejs.dev/schemas/1.9.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "organizeImports": {
    "enabled": true
  },
  "json": {
    "linter": {
      "enabled": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },

        "noUselessStringConcat": {
          "level": "error",
          "fix": "unsafe"
        },

        "noUselessUndefinedInitialization": {
          "level": "error",
          "fix": "safe"
        },

        "noVoid": {
          "level": "error"
        }
      },
      "correctness": {
        "noUndeclaredVariables": {
          "level": "error"
        },
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        }
      },
      "nursery": {
        "noCommonJs": {
          "level": "error"
        },
        "noEnum": {
          "level": "error"
        },
        "noNestedTernary": {
          "level": "error"
        }
      },
      "performance": {
        "noBarrelFile": {
          "level": "off"
        },
        "noReExportAll": {
          "level": "error"
        }
      },
      "style": {
        "noDoneCallback": {
          "level": "error"
        },
        "noNamespace": {
          "level": "error"
        },
        "useImportType": {
          "level": "error",
          "fix": "safe"
        },
        "noNamespaceImport": {
          "level": "error"
        },
        "noNegationElse": {
          "level": "error",
          "fix": "safe"
        },
        "useBlockStatements": {
          "level": "error",
          "fix": "unsafe"
        },
        "useConsistentArrayType": {
          "level": "error",
          "fix": "unsafe",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useDefaultSwitchClause": {
          "level": "error"
        },
        "useExplicitLengthCheck": {
          "level": "error",
          "fix": "unsafe"
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true,
            "filenameCases": ["camelCase"]
          }
        },
        "useForOf": {
          "level": "error"
        },
        "useNamingConvention": {
          "level": "error",
          "fix": "safe",
          "options": {
            "requireAscii": true,
            "strictCase": true
          }
        },
        "useShorthandArrayType": {
          "level": "error",
          "fix": "unsafe"
        },
        "useShorthandAssign": {
          "level": "error",
          "fix": "unsafe"
        },
        "useThrowNewError": {
          "level": "error",
          "fix": "unsafe"
        },
        "useThrowOnlyError": {
          "level": "error"
        }
      },
      "suspicious": {
        "noEmptyBlockStatements": {
          "level": "error"
        },
        "noMisplacedAssertion": {
          "level": "error"
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "include": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "off"
          }
        }
      }
    }
  ]
}
