{
  "name": "@aviene/aws-lambda",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "pnpm dlx tsx ./build.ts && tsc ./src/index.ts --declaration --emitDeclarationOnly",
    "lint": "pnpm biome lint ./src --write",
    "format": "pnpm biome format ./src --write",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --config=vitest.config.unit.ts",
    "test:integration": "vitest --config=vitest.config.integration.ts",
    "test:perf": "vitest --config=vitest.config.perf.ts"
  },
  "peerDependencies": {
    "zod": "3.x"
  },
  "dependencies": {
    "@middy/core": "5",
    "@aws-lambda-powertools/parser": "2",
    "@aws-lambda-powertools/logger": "2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@middy/core": "^5.5.1",
    "@aws-lambda-powertools/parser": "^2.10.0",
    "@aws-lambda-powertools/logger": "^2.10.0",

    "@aviene/typescript-config": "workspace:*",
    "@aviene/tsup-config": "workspace:*",

    "@aviene/vitest-config": "workspace:*"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "url": "https://github.com/stefan-karlsson/aviene-core/",
    "directory": "packages/framework/aws-lambda"
  }
}
