{
  "name": "@aviene/commands",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "tsup-node ./src/* && tsc --declaration --emitDeclarationOnly",
    "lint": "pnpm biome lint ./src --write",
    "format": "pnpm biome format ./src --write",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --config=vitest.config.unit.ts",
    "test:integration": "vitest --config=vitest.config.integration.ts",
    "test:perf": "vitest --config=vitest.config.perf.ts"
  },
  "peerDependencies": {
    "@aviene/guards": "0.x",
    "@aviene/exceptions": "0.x",
    "@aviene/context": "0.x",
    "@aviene/message-bus": "0.x",
    "@aviene/types": "0.x"
  },
  "devDependencies": {
    "@aviene/guards": "workspace:*",
    "@aviene/exceptions": "workspace:*",
    "@aviene/context": "workspace:*",
    "@aviene/message-bus": "workspace:*",
    "@aviene/types": "workspace:*",
    "@aviene/tsconfig": "workspace:*",
    "@aviene/tsup": "workspace:*",
    "@aviene/vitest": "workspace:*"
  },
  "files": ["src"],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "url": "https://github.com/stefan-karlsson/aviene-core/",
    "directory": "packages/framework/application/commands"
  }
}
