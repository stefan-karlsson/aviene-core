{
  "name": "@aviene/framework",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "pnpm dlx tsx ./build.ts && tsc ./src/index.ts --declaration --emitDeclarationOnly",
    "lint": "pnpm biome lint ./src --write",
    "format": "pnpm biome format ./src --write"
  },
  "peerDependencies": {
    "@aviene/commands": "0.x",
    "@aviene/context": "0.x",
    "@aviene/exceptions": "0.x",
    "@aviene/guards": "0.x",
    "@aviene/logging": "0.x",
    "@aviene/message-bus": "0.x",
    "@aviene/types": "0.x",
    "@aviene/building-blocks": "0.x",
    "@aviene/value-objects": "0.x",
    "@aviene/aws-lambda": "0.x",
    "@aviene/controllers": "0.x",
    "@aviene/request-dtos": "0.x",
    "@aviene/response-dtos": "0.x"
  },
  "devDependencies": {
    "@aviene/commands": "workspace:*",
    "@aviene/context": "workspace:*",
    "@aviene/exceptions": "workspace:*",
    "@aviene/guards": "workspace:*",
    "@aviene/logging": "workspace:*",
    "@aviene/message-bus": "workspace:*",
    "@aviene/types": "workspace:*",
    "@aviene/building-blocks": "workspace:*",
    "@aviene/value-objects": "workspace:*",
    "@aviene/aws-lambda": "workspace:*",
    "@aviene/controllers": "workspace:*",
    "@aviene/request-dtos": "workspace:*",
    "@aviene/response-dtos": "workspace:*"
  },
  "files": ["src"],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./interface": {
      "import": "./dist/interface.mjs",
      "require": "./dist/interface.cjs",
      "types": "./dist/interface.d.ts"
    },
    "./app": {
      "import": "./dist/application.mjs",
      "require": "./dist/application.cjs",
      "types": "./dist/application.d.ts"
    },
    "./domain": {
      "import": "./dist/domain.mjs",
      "require": "./dist/domain.cjs",
      "types": "./dist/domain.d.ts"
    },
    "./infra": {
      "import": "./dist/infrastructure.mjs",
      "require": "./dist/infrastructure.cjs",
      "types": "./dist/infrastructure.d.ts"
    },
    "./common": {
      "import": "./dist/common.mjs",
      "require": "./dist/common.cjs",
      "types": "./dist/common.d.ts"
    },

    "./package.json": "./package.json"
  },
  "repository": {
    "url": "https://github.com/stefan-karlsson/aviene-core/",
    "directory": "packages/server/framework/_framework"
  }
}
