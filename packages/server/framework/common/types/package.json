{
  "name": "@aviene/types",
  "version": "0.0.0",
  "description": "Common types",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "tsup-node ./src/* && tsc --declaration --emitDeclarationOnly",
    "lint": "pnpm biome lint ./src --write",
    "format": "pnpm biome format ./src --write"
  },
  "dependencies": {
    "oxide.ts": "^1.1.0"
  },
  "devDependencies": {
    "@aviene/tsconfig": "workspace:*",
    "@aviene/tsup": "workspace:*"
  },
  "files": ["src"],
  "repository": {
    "url": "https://github.com/stefan-karlsson/aviene-core/",
    "directory": "packages/framework/common/types"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  }
}
